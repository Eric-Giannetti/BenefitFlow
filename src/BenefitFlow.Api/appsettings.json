{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=benefitflow;Username=benefitflow;Password=benefitflow",
    "Redis": "localhost:6379"
  },
  "Reservations": {
    "PendingExpirationMinutes": 5,
    "ReadCacheTimeToLiveSeconds": 30,
    "IdempotencyCacheTimeToLiveHours": 24
  },
  "Eligibility": {
    "FailFirstRequests": 0
  },
  "Database": {
    "ApplyMigrations": false,
    "SeedDemoData": false
  },
  "OpenTelemetry": {
    "Endpoint": "http://localhost:4317"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672
  },
  "AllowedHosts": "*"
}
